min_version = "2026.8.12"

[tools]
bat = "0.26.1"
difftastic = "0.71.0"
doggo = "1.4.0"
fd = "10.5.0"
fzf = "0.74.4"
github-cli = "2.102.0"
"github:neovim/neovim" = "0.12.5"
"github:nushell/nushell" = "0.116.0"
"github:twpayne/chezmoi" = "2.73.0"
"github:skevetter/devpod" = "0.26.2"
herdr = "0.9.3"
jj = "0.45.1"
lsd = "1.2.0"
node = "26.10.0"
ripgrep = "15.2.0"
starship = "1.26.0"
zellij = "0.45.1"

# my additions (kept separate from upstream's list to ease merges)
age = "1.3.2"
btop = "1.4.7"
cloudflared = "2026.9.1"
cosign = "3.1.3"
crictl = "1.37.0"
flux2 = "2.9.5"
glab = "1.118.0"
go = "1.27.1"
helm = "4.3.0"
hugo-extended = "0.166.0"
k9s = "0.51.0"
kubectl = "1.37.0"
kubectx = "0.11.0"
kubens = "0.11.0"
lazygit = "0.65.1"
powershell = "7.6.6"
shellcheck = "0.11.0"
sops = "3.13.3"
talosctl = "1.14.1"
tealdeer = "1.9.0"
tree-sitter = "0.27.0"
yq = "4.53.6"
{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "amd64") -}}
"github:Canop/dysk" = { version = "3.7.0", bin_path = "x86_64-unknown-linux-musl" }
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
colima = "0.10.3"
lima = "2.2.0"
{{ end -}}

[settings]
experimental = true
lockfile = true
pin = true
minimum_release_age = "7d"

[env]
'_'.path = [
  "~/.cargo/bin",
  "/opt/homebrew/bin",
]
'_'.file = { path = ".envrc" }

{{ if eq .chezmoi.os "darwin" -}}
[bootstrap.packages]
"brew-cask:ghostty" = "latest"
"brew-cask:1password" = "latest"
"brew-cask:alt-tab" = "latest"
"brew:docker" = "latest"
"brew:docker-compose" = "latest"
"brew:docker-buildx" = "latest"
{{end -}}
