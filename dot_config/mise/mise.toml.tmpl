min_version = "2026.8.12"

[tools]
bat = "0.26.1"
difftastic = "0.69.0"
doggo = "1.2.0"
fd = "10.4.2"
fzf = "0.74.2"
github-cli = "2.97.0"
"github:neovim/neovim" = "0.12.0"
"github:nushell/nushell" = { version = "0.115.1", exe = "nu" }
"github:twpayne/chezmoi" = "2.72.1"
"github:skevetter/devpod" = "0.26.1"
herdr = "0.9.1"
jj = "0.44.0"
lsd = "1.2.0"
node = "24.18.0"
ripgrep = "15.2.0"
starship = "1.26.0"
zellij = "0.44.3"

# my additions (kept separate from upstream's list to ease merges)
age = "1.3.2"
cloudflared = "2026.9.1"
cosign = "3.1.3"
flux2 = "2.9.5"
glab = "1.118.0"
go = "1.27.1"
helm = "4.3.0"
hugo-extended = "0.166.0"
k9s = "0.51.0"
kubectl = "1.37.0"
kubectx = "0.11.0"
lazygit = "0.65.1"
powershell = "7.6.6"
shellcheck = "0.11.0"
sops = "3.13.3"
talosctl = "1.14.1"
tree-sitter = "0.27.0"
yq = "4.53.6"

{{ if eq .chezmoi.os "darwin" -}}
colima = "0.10.3"
lima = "2.2.0"
{{ end -}}

[settings]
experimental = true
lockfile = true
pin = true
minimum_release_age = "7d"

[env]
'_'.path = [
  "~/.cargo/bin",
  "/opt/homebrew/bin",
]
'_'.file = { path = ".envrc" }

{{ if eq .chezmoi.os "darwin" -}}
[bootstrap.packages]
"brew-cask:ghostty" = "latest"
"brew-cask:1password" = "latest"
"brew-cask:alt-tab" = "latest"
"brew:docker" = "latest"
"brew:docker-compose" = "latest"
"brew:docker-buildx" = "latest"
{{end -}}
