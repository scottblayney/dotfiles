#!/usr/bin/env bash
#
# Description: Install dotfiles by symlinking them into place.
#
# Clone this repo anywhere and run ./setup — it resolves its own location,
# so there is no hardcoded path to keep in sync.
#
# Each file in your home directory is a symlink pointing at the copy in this
# repo, so editing either side edits the same file and `git status` sees it.
#
# Unlike hard links, symlinks survive `git pull`, `git checkout` and branch
# switches, and they work when the repo and $HOME are on different
# filesystems. Re-running ./setup is safe and idempotent.
#
# The repo must stay where it is: moving it leaves every symlink dangling.
# Re-run ./setup from the new location to repoint them.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DRY_RUN=0
DO_BREW=0
for arg in "$@"; do
  case "$arg" in
    -n | --dry-run) DRY_RUN=1 ;;
    --brew) DO_BREW=1 ;;
    -h | --help)
      sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^#\s\?//'
      echo
      echo "Usage: ./setup [--dry-run] [--brew]"
      echo "  -n, --dry-run   show what would change, touch nothing"
      echo "      --brew      also run 'brew bundle' against ./brewfile"
      exit 0
      ;;
    *)
      echo "unknown option: $arg (try --help)" >&2
      exit 1
      ;;
  esac
done

# Files to link: "<path in repo>|<path to install to>"
# Everything under nvim/ is handled separately, recursively.
MANIFEST="
bashrc|$HOME/.bashrc
vimrc|$HOME/.vimrc
tmux.conf|$HOME/.tmux.conf
starship.toml|$HOME/.config/starship.toml
"

STAMP="$(date +%Y-%m-%d)"
linked=0 skipped=0 backed_up=0

say() { printf '%s\n' "$*"; }
run() { [ "$DRY_RUN" -eq 1 ] || "$@"; }

link_file() {
  local src="$1" dest="$2"

  if [ ! -e "$src" ]; then
    say "  missing in repo, skipping: $src"
    return
  fi

  run mkdir -p "$(dirname "$dest")"

  # Already pointing at the right file? Nothing to do.
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
    skipped=$((skipped + 1))
    return
  fi

  if [ -L "$dest" ]; then
    # A symlink holds no content of its own — just drop it. This also clears
    # away links left dangling by moving the repo.
    say "  replacing symlink  $dest"
    run rm -f "$dest"
  elif [ -e "$dest" ]; then
    if cmp -s "$src" "$dest"; then
      # Same content — either a real duplicate or an old hard link to this
      # very inode. Either way there is nothing to preserve.
      run rm -f "$dest"
    else
      say "  backing up         $dest -> $dest.bak-$STAMP"
      run mv "$dest" "$dest.bak-$STAMP"
      backed_up=$((backed_up + 1))
    fi
  fi

  run ln -sfn "$src" "$dest"
  say "  linked             $dest"
  linked=$((linked + 1))
}

[ "$DRY_RUN" -eq 1 ] && say "DRY RUN — nothing will be modified" && say ""
say "Installing dotfiles from $REPO"
say ""

while IFS='|' read -r src dest; do
  [ -z "$src" ] && continue
  link_file "$REPO/$src" "$dest"
done <<<"$MANIFEST"

# Neovim: mirror the whole nvim/ tree into ~/.config/nvim, so adding a plugin
# spec later needs no edit here. Linking per file rather than symlinking the
# directory keeps Lazy's generated state in ~/.config/nvim out of the repo.
# Hidden files are included deliberately (.neoconf.json).
if [ -d "$REPO/nvim" ]; then
  while IFS= read -r -d '' src; do
    link_file "$src" "$HOME/.config/nvim/${src#"$REPO/nvim/"}"
  done < <(find "$REPO/nvim" -type f -print0)
fi

if [ "$DO_BREW" -eq 1 ]; then
  say ""
  if command -v brew >/dev/null 2>&1; then
    say "Running brew bundle..."
    run brew bundle --file="$REPO/brewfile"
  else
    say "warning: --brew given but brew is not installed; skipping" >&2
  fi
fi

say ""
say "Done. $linked linked, $skipped already current, $backed_up backed up."
if [ "$backed_up" -gt 0 ]; then
  say "Backups were saved with the suffix .bak-$STAMP"
fi
